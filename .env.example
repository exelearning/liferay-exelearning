# Development credentials for the local Docker Compose stack only.
# Copy to .env and change the values. Never reuse them in production.

LIFERAY_PORT=8080
LIFERAY_ADMIN_PASSWORD=change-me-admin
LIFERAY_JVM_OPTS=-Xms1g -Xmx2g
# Set to true to open a JPDA debugger on 127.0.0.1:8000
LIFERAY_DEBUG=false

POSTGRES_DB=lportal
POSTGRES_USER=liferay
POSTGRES_PASSWORD=change-me-db

# Password of the demo users created by "make seed"
SEED_USER_PASSWORD=change-me-users
