{
    "name": "liferay-exelearning",
    "version": "0.1.0",
    "private": true,
    "description": "eXeLearning integration for Liferay Portal and Liferay DXP: frontend and test tooling",
    "license": "AGPL-3.0-or-later",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "node frontend/build.mjs",
        "lint": "biome ci . && tsc -p tsconfig.json --noEmit",
        "fix": "biome check --write .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test --project=e2e-chromium",
        "test:integration": "playwright test --project=integration"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.13",
        "@playwright/test": "1.63.0",
        "@types/node": "24.19.2",
        "@vitest/coverage-v8": "5.0.3",
        "esbuild": "0.28.2",
        "happy-dom": "20.14.5",
        "typescript": "6.0.3",
        "vitest": "5.0.3"
    }
}
