root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,js,mjs,json,yml,yaml,md}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[{*.java,*.jsp,*.jspf,*.gradle,*.properties,*.bnd,bnd.bnd}]
indent_style = tab

# Liferay Source Formatter removes the trailing newline from these files
[{*.java,*.jsp,*.jspf,*.gradle,*.bnd,bnd.bnd}]
insert_final_newline = false

[Makefile]
indent_style = tab
