<liferay-ui:error exception="<%= ElpxException.class %>">

	<%
	ElpxException elpxException = (ElpxException)errorException;
	%>

	<liferay-ui:message arguments="<%= elpxException.getArguments() %>" key="<%= elpxException.getKey() %>" translateArguments="<%= false %>" />
</liferay-ui:error>

<liferay-ui:error exception="<%= ResourceConflictException.class %>">

	<%
	ResourceConflictException resourceConflictException = (ResourceConflictException)errorException;
	%>

	<liferay-ui:message arguments="<%= resourceConflictException.getCurrentVersion() %>" key="<%= resourceConflictException.getKey() %>" />
</liferay-ui:error>

<liferay-ui:error exception="<%= NoSuchFileEntryException.class %>" message="the-resource-could-not-be-found" />
<liferay-ui:error exception="<%= PrincipalException.class %>" message="you-do-not-have-the-required-permissions" />